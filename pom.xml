<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>nexus.io</groupId>
  <artifactId>tio-chat-server-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <description>IM server on tio-boot: run every module as its own service, or all modules in one process</description>

  <modules>
    <module>tio-chat-common</module>
    <module>tio-chat-oauth</module>
    <module>tio-chat-base</module>
    <module>tio-chat-system</module>
    <module>tio-chat-im</module>
    <module>tio-chat-ai</module>
    <module>tio-chat-ws</module>
    <module>tio-chat-generator</module>
    <module>tio-chat-all</module>
    <module>tio-chat-gateway</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>

    <lombok-version>1.18.44</lombok-version>
    <fastjson2.version>2.0.52</fastjson2.version>
    <hotswap-classloader.version>1.2.9</hotswap-classloader.version>
    <tio-boot.version>2.1.9</tio-boot.version>
    <tio-boot-cloud.version>1.0.0</tio-boot-cloud.version>
    <jfinal-aop.version>1.4.0</jfinal-aop.version>
    <java-model.version>1.2.8</java-model.version>
    <java-db.version>1.6.2</java-db.version>
    <java-openai.version>1.3.8</java-openai.version>
  </properties>

  <!-- every module compiles with lombok -->
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok-version}</version>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- the Baidu SMS SDK brings httpclient 4.3, the WeChat SDK needs 4.5: with every module in one jar the
           older one would win and the WeChat portal fail at runtime -->
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>4.5.13</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpcore</artifactId>
        <version>4.4.14</version>
      </dependency>
      <!-- logback 1.3 needs slf4j 2; jedis brings slf4j 1.7 -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.7</version>
      </dependency>
      <!-- fst brings jackson-core 2.8; nacos-client needs the version matching its jackson-databind -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.18.4</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-oauth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-base</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-system</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-generator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-im</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-chat-ws</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>nexus.io</groupId>
        <artifactId>tio-boot-cloud-gateway</artifactId>
        <version>${tio-boot-cloud.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- the shaded jar replaces the main artifact; rebuild it every time, otherwise packaging without clean
           shades the previous jar over the new dependencies and silently keeps old classes -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <!-- runnable modules: an executable jar with all dependencies, java -jar target/xxx.jar -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.5.1</version>
          <executions>
            <execution>
              <phase>package</phase>
              <goals>
                <goal>shade</goal>
              </goals>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                      <exclude>META-INF/versions/**/module-info.class</exclude>
                      <exclude>module-info.class</exclude>
                    </excludes>
                  </filter>
                </filters>
                <transformers>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>${main.class}</mainClass>
                  </transformer>
                </transformers>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
